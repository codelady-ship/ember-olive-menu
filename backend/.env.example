# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
# MongoDB Atlas (or local) connection string
MONGODB_URI=mongodb://127.0.0.1:27017/ember-olive
# Long random string (at least 32 characters) used to sign admin tokens
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h
# Comma-separated list of allowed browser origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173,https://codelady-ship.github.io
# Seats available per reservation slot
RES_SLOT_CAPACITY=24
# Largest party that can book online
RES_MAX_PARTY=10
# How far ahead (days) a table can be booked
RES_DAYS_AHEAD=90
# IANA time zone of the restaurant (used for "today" and past-slot checks)
RESTAURANT_TZ=Europe/London
# Where uploaded dish images are stored (served at /uploads)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=3
# Used once by `npm run create-admin` (then remove from the environment)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# The public read-only demo admin (demo@ember-olive.demo / demo1234) is created by
# `npm run seed` and on start; it sees placeholders instead of guest data.
# DEMO_ADMIN=false turns it off: login refused, demo tokens rejected, account deleted on start.
# DEMO_ADMIN=false
