# Copy to .env.local for development. Never commit real values.
# Base URL of the API, e.g. https://ember-olive-api.onrender.com (leave empty to use the built-in demo menu)
VITE_API_URL=
# Public path the site is served from (GitHub Pages project site)
VITE_BASE=/ember-olive-menu/
# Canonical URL used for meta tags, JSON-LD and the sitemap
VITE_SITE_URL=https://codelady-ship.github.io/ember-olive-menu/
